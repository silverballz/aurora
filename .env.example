# Aurora - Environment Configuration
# Kaltarang 2026 External Participant Identity & Access System

# Base URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Subdomain URLs (Optional, defaults to paths /portal, /admin, /security if subdomains not configured)
NEXT_PUBLIC_PORTAL_URL=http://localhost:3000/portal
NEXT_PUBLIC_ADMIN_URL=http://localhost:3000/admin
NEXT_PUBLIC_SECURITY_URL=http://localhost:3000/security

# Supabase Configuration (Free tier on supabase.com)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Email Delivery Provider (Options: 'resend', 'smtp', 'console')
# Uses free tier: Resend (free 3,000 emails/mo), free Gmail SMTP, or 'console' dev mode
EMAIL_PROVIDER=console
EMAIL_FROM=Kaltarang 2026 <no-reply@kaltarang.in>

# Resend API Key (Get free key at resend.com)
RESEND_API_KEY=re_123456789

# Free SMTP Settings (e.g. Gmail SMTP or Brevo free tier)
# For Gmail: host=smtp.gmail.com, port=465, user=your_email@gmail.com, pass=your_16_char_app_password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=

# Security & QR Signing Secret
QR_SIGNING_SECRET=generate-a-strong-random-secret-here-at-least-32-chars

# App Environment
NODE_ENV=development
